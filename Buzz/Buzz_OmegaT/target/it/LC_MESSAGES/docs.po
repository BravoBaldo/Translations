msgstr "**Timestamp**: Mostra i segmenti in formato tabellare con orari di inizio/fine"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:22
msgid "**Text**: Shows combined text without timestamps"
msgstr "**Text**: Mostra il testo combinato senza timestamp"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:23
msgid "**Translation**: Shows translated text (if available)"
msgstr "**Translation**: Mostra il testo tradotto (se disponibile)"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:25
msgid "Export Button"
msgstr "Pulsante Export"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:26
msgid "**Function**: Export transcription in various formats"
msgstr "**Funzione**: Esporta la trascrizione in vari formati"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:27
msgid "**Formats**: SRT, VTT, TXT, JSON, and more"
msgstr "**Formati**: SRT, VTT, TXT, JSON e altro"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:28
