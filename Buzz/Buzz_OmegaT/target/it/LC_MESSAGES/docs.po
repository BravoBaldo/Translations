#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:49
msgid "**Behavior**: Toggle button that shows/hides the search bar"
msgstr "**Comportamento**: Pulsante di attivazione/disattivazione che mostra/nasconde la barra di ricerca"

#: ../../Buzz_Sphinx/source/docs/docs/usage/5_transcription_viewer.md:51
msgid "Scroll to Current Button"
