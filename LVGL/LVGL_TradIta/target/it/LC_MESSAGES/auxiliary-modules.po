msgstr "Video,"

#: ../../lvgl/docs/intermediate/auxiliary-modules/file_explorer.rst:18
msgid "Pictures,"
msgstr "Pictures,"

#: ../../lvgl/docs/intermediate/auxiliary-modules/file_explorer.rst:19
msgid "Music, and"
msgstr "Music, e"

