#: ../../ref-manual/classes.rst:3034
msgid ""
":term:`SYSLINUX_DEFAULT_CONSOLE`: Set to \"console=ttyX\" to change "
"kernel boot default console."
msgstr ""

#: ../../ref-manual/classes.rst:3037
msgid ""
":term:`SYSLINUX_SERIAL`: Sets an alternate serial port. Or, turns off "
"serial when the variable is set with an empty string."
msgstr ""

#: ../../ref-manual/classes.rst:3041
msgid ""
":term:`SYSLINUX_SERIAL_TTY`: Sets an alternate \"console=tty...\" kernel "
"boot argument."
msgstr ""

#: ../../ref-manual/classes.rst:3047 ../../ref-manual/variables.rst:4986
msgid "``systemd``"
msgstr ""

#: ../../ref-manual/classes.rst:3049
msgid ""
"The :ref:`ref-classes-systemd` class provides support for recipes that "
"install systemd unit files."
