#: ../../ref-manual/features.rst:168
msgid "*ipsec:* Include IPSec support."
msgstr ""

#: ../../ref-manual/features.rst:170
msgid "*ipv4:* Include IPv4 support."
msgstr ""

#: ../../ref-manual/features.rst:172
msgid "*ipv6:* Include IPv6 support."
msgstr ""

#: ../../ref-manual/features.rst:174
msgid ""
"*keyboard:* Include keyboard support (e.g. keymaps will be loaded during "
