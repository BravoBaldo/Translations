#: ../../ref-manual/variables.rst:8946
msgid "``tar.zst``"
msgstr ""

#: ../../ref-manual/variables.rst:8947
msgid "``7zip``"
msgstr ""

#: ../../ref-manual/variables.rst:8948
msgid "``zip``"
msgstr ""

#: ../../ref-manual/variables.rst:8950
msgid "Only one archive type can be specified."
msgstr ""

#: ../../ref-manual/variables.rst:8951
msgid ":term:`SDK_AS_ARCH`"
msgstr ""

#: ../../ref-manual/variables.rst:8953
msgid ""
"Specifies architecture-specific assembler flags when building :ref:`ref-"
"classes-nativesdk` recipes. By default, the value of :term:`SDK_AS_ARCH` "
"equals the one of :term:`BUILD_AS_ARCH`."
msgstr ""

#: ../../ref-manual/variables.rst:8956
msgid ":term:`SDK_BUILDINFO_FILE`"
msgstr ""

#: ../../ref-manual/variables.rst:8958
msgid ""
"When using the :ref:`ref-classes-image-buildinfo` class, specifies the "
"file in the SDK to write the build information into. The default value is"
