#: ../../ref-manual/features.rst:439
msgid "The SDK features available are:"
msgstr ""

#: ../../ref-manual/features.rst:441
msgid "``go``: add `Go` utilities for building `Go`-based applications."
msgstr ""

#: ../../ref-manual/features.rst:443
msgid "``kernel-src``: adds the Linux kernel source tree to the SDK."
msgstr ""

#: ../../ref-manual/features.rst:445
msgid "``rust``: add `Rust` utilities for building `Rust`-based applications."
