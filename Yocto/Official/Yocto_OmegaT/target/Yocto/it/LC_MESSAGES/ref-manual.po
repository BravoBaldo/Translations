#: ../../ref-manual/variables.rst:9999
msgid ":term:`SPL_SIGN_ENABLE`"
msgstr ""

#: ../../ref-manual/variables.rst:10001
msgid ""
"Enable signing of the U-Boot FIT image. The default value is \"0\". This "
