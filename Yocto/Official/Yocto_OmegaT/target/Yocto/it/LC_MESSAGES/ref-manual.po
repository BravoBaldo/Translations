msgid ""
"``<recipefile>: Variable <variable> is set as not being package specific,"
" please fix this. [pkgvarcheck]``"
msgstr ""

#: ../../ref-manual/qa-checks.rst:716
#, python-brace-format
msgid ""
"Certain variables (:term:`RDEPENDS`, :term:`RRECOMMENDS`, "
":term:`RSUGGESTS`, :term:`RCONFLICTS`, :term:`RPROVIDES`, "
":term:`RREPLACES`, :term:`FILES`, ``pkg_preinst``, ``pkg_postinst``, "
"``pkg_prerm``, ``pkg_postrm``, and :term:`ALLOW_EMPTY`) should always be "
"set specific to a package (i.e. they should be set with a package name "
"override such as ``RDEPENDS:${PN} = \"value\"`` rather than ``RDEPENDS = "
"\"value\"``). If you receive this error, correct any assignments to these"
" variables within your recipe."
msgstr ""

#: ../../ref-manual/qa-checks.rst:730
#, python-brace-format
msgid "``recipe uses DEPENDS:${PN}, should use DEPENDS [pkgvarcheck]``"
msgstr ""

