#: ../../ref-manual/variables.rst:2932
msgid ""
"\"dbg-pkgs\" --- adds -dbg packages for all installed packages including "
"symbol information for debugging and profiling."
msgstr ""

#: ../../ref-manual/variables.rst:2935
msgid ""
"\"empty-root-password\" --- This feature can be used if you want to allow"
" root login with an empty password."
