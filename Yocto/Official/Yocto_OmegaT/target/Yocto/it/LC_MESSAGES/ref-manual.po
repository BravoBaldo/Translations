#: ../../ref-manual/variables.rst:8936
msgid "See :doc:`/security-manual/vulnerabilities` for more information."
msgstr ""

#: ../../ref-manual/variables.rst:8937
msgid ":term:`SDK_ARCH`"
msgstr ""

#: ../../ref-manual/variables.rst:8939
