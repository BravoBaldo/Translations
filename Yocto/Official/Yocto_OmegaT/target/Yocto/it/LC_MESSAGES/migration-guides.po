#: ../../migration-guides/migration-4.0.rst:132
msgid ""
"``libportal``: moved to meta-gnome - no longer needed by anything in OE-"
"Core"
msgstr ""

#: ../../migration-guides/migration-4.0.rst:133
msgid ""
"``linux-yocto``: removed version 5.14 recipes (5.15 and 5.10 still "
"provided)"
msgstr ""

#: ../../migration-guides/migration-4.0.rst:134
msgid ""
"``python3-nose``: has not changed since 2016 upstream, and no longer "
"needed by anything in OE-Core"
msgstr ""

#: ../../migration-guides/migration-4.0.rst:135
msgid "``rustfmt``: not especially useful as a standalone recipe"
