#: ../../migration-guides/migration-2.7.rst:137
msgid "*gtk-icon-utils-native*: These tools are now provided by gtk+3-native"
msgstr ""

#: ../../migration-guides/migration-2.7.rst:138
msgid ""
"*gcc-cross-initial*: No longer needed. gcc-cross/gcc-crosssdk is now used"
" instead."
msgstr ""

#: ../../migration-guides/migration-2.7.rst:139
msgid ""
"*gcc-crosssdk-initial*: No longer needed. gcc-cross/gcc-crosssdk is now "
"used instead."
msgstr ""

#: ../../migration-guides/migration-2.7.rst:140
msgid ""
"*glibc-initial*: Removed because the benefits of having it for "
"site_config are currently outweighed by the cost of building the recipe."
