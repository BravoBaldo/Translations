#: ../../migration-guides/migration-3.0.rst:91
msgid "``python-nose``: Removed the Python 2.x version of the recipe."
msgstr ""

#: ../../migration-guides/migration-3.0.rst:93
msgid "``python-numpy``: Removed the Python 2.x version of the recipe."
