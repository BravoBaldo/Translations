#: ../../FastLED_Sphinx/source/examples/Validation/ai_prompt.md:113
msgid "Launch sub agents for each file that needs to be fixed."
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/ai_prompt.md:114
msgid "Then compile the code with this command:"
