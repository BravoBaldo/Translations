#: ../../FastLED_Sphinx/source/examples/AGENTS.md:100
msgid "❌ `#include <vector>` → ✅ `#include \"fl/vector.h\"`"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/AGENTS.md:101
