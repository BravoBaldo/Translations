msgid "Test Patterns"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:252
msgid ""
"The sketch runs **4 mixed RGB bit patterns** to comprehensively test MSB "
"vs LSB handling:"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:254
msgid "Pattern A: R=0xF0, G=0x0F, B=0xAA"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:255
msgid "**R channel**: `0xF0` (11110000) - High nibble set (tests high bits)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:256
msgid "**G channel**: `0x0F` (00001111) - Low nibble set (tests low bits)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:257
msgid "**B channel**: `0xAA` (10101010) - Alternating bits (tests MSB/LSB order)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:259
msgid "**Purpose**: Detects if driver incorrectly inverts bit order within bytes"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:261
msgid "Pattern B: R=0x55, G=0xFF, B=0x00"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:262
msgid "**R channel**: `0x55` (01010101) - Alternating bits (opposite of 0xAA)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:263
msgid "**G channel**: `0xFF` (11111111) - All bits high (boundary test)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:264
msgid "**B channel**: `0x00` (00000000) - All bits low (boundary test)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:266
msgid "**Purpose**: Tests boundary conditions and alternating bit patterns"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:268
msgid "Pattern C: R=0x0F, G=0xAA, B=0xF0"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:269
msgid "**R channel**: `0x0F` (00001111) - Low nibble set"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:270
msgid "**G channel**: `0xAA` (10101010) - Alternating bits"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:271
msgid "**B channel**: `0xF0` (11110000) - High nibble set"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:273
msgid ""
"**Purpose**: Rotated pattern from A - ensures driver handles different "
"channel values correctly"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:275
msgid "Pattern D: RGB Solid Alternating"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:276
msgid "**LED 0**: Red (255, 0, 0)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:277
msgid "**LED 1**: Green (0, 255, 0)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:278
msgid "**LED 2**: Blue (0, 0, 255)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:279
msgid "**LED 3**: Red (repeating pattern)"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:281
msgid "**Purpose**: Baseline test - ensures basic RGB transmission works"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:283
msgid "Why Mixed Bit Patterns Matter"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:285
msgid ""
"Traditional solid color tests (all red, all green, all blue) only "
"exercise a limited subset of bit combinations. Mixed patterns catch "
"subtle encoding bugs:"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:287
msgid ""
"**MSB-first vs LSB-first**: If driver sends bits in wrong order, `0xF0` "
"becomes `0x0F`"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:288
msgid "**Nibble swapping**: High/low nibble errors are immediately visible"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:289
msgid "**Bit inversion**: Patterns like `0xAA` and `0x55` expose bit flip errors"
msgstr ""

#: ../../FastLED_Sphinx/source/examples/Validation/README.md:290
msgid ""
"**Channel crosstalk**: Different values per channel detect cross-channel "
"corruption"
msgstr ""

