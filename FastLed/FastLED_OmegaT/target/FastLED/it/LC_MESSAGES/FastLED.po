msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:16
msgid "Objective: Fix 1-bit shift error caused by buffer boundary misalignment"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:18
msgid "Critical Constraint"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:20
msgid "**AGENTS ARE NOT ALLOWED TO MODIFY `trans_queue_depth` IN ANY WAY**"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:22
msgid ""
"The `trans_queue_depth = 3` setting is MANDATORY and MUST NOT be changed."
" This value:"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:23
msgid "Matches the 3 ring buffer count"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:24
msgid "Allows all 3 buffers to be pre-queued without queue full errors"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:25
msgid "Was established in LOOP.md as the correct configuration"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:27
msgid "**ONLY BUFFER SIZE ALIGNMENT IS ALLOWED**"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:29
msgid ""
"Agents may ONLY modify buffer size calculations to ensure proper byte "
"alignment."
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:32
msgid "Problem Statement"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:34
msgid "**Current Issue**: 1-bit shift corruption in transmitted LED data"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:36
msgid "**Root Cause Analysis** (from commit 4fd8a0c08):"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:37
msgid "Buffer splits occur on non-byte boundaries"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:38
msgid "PARLIO hardware interprets inter-buffer gaps as bit-level shifts"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:39
msgid ""
"Per WLED-MM developer: \"I also break my buffers so it's after the LSB of"
" the triplet (or quad)\""
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:40
msgid ""
"Byte boundaries are critical - nibble splits trigger corruption on any "
"order bit"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:42
msgid "**Evidence**:"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:43
msgid "Multi-run validation shows consistent bit shift errors"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:44
msgid "Pattern: RGB(240,15,170) transmitted as corrupted values"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:45
msgid "Shift happens at buffer boundaries, not uniformly across transmission"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:47
msgid "**Correct Approach**:"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:48
msgid ""
"Buffer sizes MUST align to LED byte boundaries (multiples of 3 bytes for "
"RGB)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:49
msgid "Split ONLY after complete LED triplets (R,G,B) - never mid-LED"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:50
msgid ""
"Minimize risk: If 20µs gap is misinterpreted, worst case is LSB "
"corruption (0,0,0 → 0,0,1)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/prompt_fix_parlio_bitshift.md:53
msgid "Instructions for progress"
msgstr ""

