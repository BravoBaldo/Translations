#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:398
msgid "Test Patterns"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:400
msgid ""
"The sketch runs **4 mixed RGB bit patterns** to comprehensively test MSB "
"vs LSB handling:"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:402
msgid "Pattern A: R=0xF0, G=0x0F, B=0xAA"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:403
msgid "**R channel**: `0xF0` (11110000) - High nibble set (tests high bits)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:404
msgid "**G channel**: `0x0F` (00001111) - Low nibble set (tests low bits)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:405
msgid "**B channel**: `0xAA` (10101010) - Alternating bits (tests MSB/LSB order)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:407
msgid "**Purpose**: Detects if driver incorrectly inverts bit order within bytes"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:409
msgid "Pattern B: R=0x55, G=0xFF, B=0x00"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:410
msgid "**R channel**: `0x55` (01010101) - Alternating bits (opposite of 0xAA)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:411
msgid "**G channel**: `0xFF` (11111111) - All bits high (boundary test)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:412
msgid "**B channel**: `0x00` (00000000) - All bits low (boundary test)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:414
msgid "**Purpose**: Tests boundary conditions and alternating bit patterns"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:416
msgid "Pattern C: R=0x0F, G=0xAA, B=0xF0"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:417
msgid "**R channel**: `0x0F` (00001111) - Low nibble set"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:418
msgid "**G channel**: `0xAA` (10101010) - Alternating bits"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:419
msgid "**B channel**: `0xF0` (11110000) - High nibble set"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:421
msgid ""
"**Purpose**: Rotated pattern from A - ensures driver handles different "
"channel values correctly"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:423
msgid "Pattern D: RGB Solid Alternating"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:424
msgid "**LED 0**: Red (255, 0, 0)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:425
msgid "**LED 1**: Green (0, 255, 0)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:426
msgid "**LED 2**: Blue (0, 0, 255)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:427
msgid "**LED 3**: Red (repeating pattern)"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:429
msgid "**Purpose**: Baseline test - ensures basic RGB transmission works"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:431
msgid "Why Mixed Bit Patterns Matter"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:433
msgid ""
"Traditional solid color tests (all red, all green, all blue) only "
"exercise a limited subset of bit combinations. Mixed patterns catch "
"subtle encoding bugs:"
msgstr ""

#: ../../FastLED_Sphinx/source/FastLED/examples/Validation/README.md:435
msgid ""
